{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Jylhis Docs",
  "colors": {
    "primary": "#9a5a2a",
    "light": "#e89b5e",
    "dark": "#7a4622"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "JetBrains Mono",
      "weight": 500
    },
    "body": {
      "family": "Literata",
      "weight": 400
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "Knowledge",
        "groups": [
          {
            "group": "Linux",
            "pages": [
              "knowledge/linux-toolbox"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Projects",
          "href": "https://www.jylhis.com/projects/",
          "icon": "folder-open"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/Jylhis",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "jylhis.com",
        "href": "https://jylhis.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Website",
      "href": "https://www.jylhis.com"
    }
  },
  "background": {
    "color": {
      "light": "#faf7f2",
      "dark": "#1a1714"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "search": {
    "prompt": "Search the notebook…"
  },
  "description": "From me, for me",
  "appearance": {
    "default": "system"
  },
  "css": "/custom.css",
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true,
    "codeblocks": {
      "themes": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "navigable"
  },
  "interaction": {
    "drilldown": true
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "That page doesn't exist (yet). Try the [index](/) or the [knowledge base](/knowledge/linux-toolbox)."
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Jylhis",
      "linkedin": "https://www.linkedin.com/in/jylhis"
    }
  }
}
